text = input("Enter text: ")
key = 3

result = ""

for ch in text:
    if ch.isalpha():
        if ch.isupper():
            result += chr((ord(ch) - 65 + key) % 26 + 65)
        else:
            result += chr((ord(ch) - 97 + key) % 26 + 97)
    else:
        result += ch

print("Encrypted text:", result)
