text = input("Enter text: ")
key = int(input("Enter key: "))

result = ""
count = 0

for ch in text:
    if ch.isalpha():
        shift = key + count

        if ch.isupper():
            result += chr((ord(ch) - 65 + shift) % 26 + 65)
        else:
            result += chr((ord(ch) - 97 + shift) % 26 + 97)

        count += 1
    else:
        result += ch

print("Encrypted text:", result)
