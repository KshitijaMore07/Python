# FUZZY RELATION EQUIVALENCE CHECK

# Max-Min Composition
def composition(R):
    n = len(R)

    C = []

    for i in range(n):
        row = []

        for j in range(n):

            maximum = 0

            for k in range(n):

                # Find minimum
                if R[i][k] < R[k][j]:
                    minimum = R[i][k]
                else:
                    minimum = R[k][j]

                # Find maximum
                if minimum > maximum:
                    maximum = minimum

            row.append(maximum)

        C.append(row)

    return C


# Check Reflexive
def reflexive(R):
    n = len(R)

    for i in range(n):
        if R[i][i] != 1:
            return False

    return True


# Check Symmetric
def symmetric(R):
    n = len(R)

    for i in range(n):
        for j in range(n):

            if R[i][j] != R[j][i]:
                return False

    return True


# Check Transitive
def transitive(R):
    C = composition(R)
    n = len(R)

    for i in range(n):
        for j in range(n):

            if C[i][j] > R[i][j]:
                return False

    return True


# ---------------- MAIN PROGRAM ----------------

print("FUZZY RELATION EQUIVALENCE CHECKER")

n = int(input("Enter matrix size: "))

R = []

print("Enter matrix values:")

for i in range(n):

    row = []

    for j in range(n):
        x = float(input("Enter value: "))
        row.append(x)

    R.append(row)


# Display Matrix
print("\nRelation Matrix:")

for i in range(n):
    print(R[i])


# Check properties
r = reflexive(R)
s = symmetric(R)
t = transitive(R)

print("\nProperties:")

print("Reflexive :", r)
print("Symmetric :", s)
print("Transitive:", t)


# Equivalence Relation
if r == True and s == True and t == True:
    print("\nRelation is an Equivalence Relation.")
else:
    print("\nRelation is NOT an Equivalence Relation.")


# Max-Min Composition
print("\nMax-Min Composition (R o R):")

C = composition(R)

for i in range(n):
    print(C[i])
